# Public development template only: copy to an untracked .env for local use.
# Never commit real passwords, tokens or provider credentials. Set deployment
# secrets in the hosting provider's environment/secret manager, not in Git.
# Production rejects DEBUG=true, the sample JWT/DB credentials and HTTP origins.
TICKET_APP_ENV=development
TICKET_APP_NAME=E-Ticket Platform
TICKET_DEBUG=true
TICKET_DATABASE_URL=postgresql+asyncpg://ticket_user:ticket_password@db:5432/ticket_platform
TICKET_REDIS_URL=redis://redis:6379/0
TICKET_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TICKET_JWT_ALGORITHM=HS256
TICKET_ACCESS_TOKEN_EXPIRE_MINUTES=30
TICKET_ORDER_RESERVATION_MINUTES=15
TICKET_P2P_WITHDRAWAL_PERCENTAGE_BPS=5000
TICKET_P2P_MIN_WITHDRAWAL_PAISE=5000
TICKET_P2P_MAX_WITHDRAWAL_PAISE=10000000
TICKET_P2P_THRESHOLD_OVERRIDE_ENABLED=false
TICKET_P2P_THRESHOLD_PAISE=0
TICKET_P2P_BUYER_PAYMENT_WINDOW_MINUTES=15
TICKET_P2P_RECEIVER_CONFIRMATION_WINDOW_MINUTES=30
TICKET_P2P_RULE_VERSION=p2p-v1-default
TICKET_P2P_HIGH_RISK_MAKER_CHECKER_REQUIRED=false
TICKET_P2P_REQUIRE_VERIFIED_USERS=false
# Leave unset until a real P2P provider has supplied a webhook signing secret.
TICKET_P2P_PROVIDER_WEBHOOK_SECRET=
TICKET_P2P_OUTBOX_BATCH_SIZE=100
TICKET_P2P_EXPIRY_POLL_SECONDS=60
TICKET_P2P_OUTBOX_POLL_SECONDS=15
# Phase 5 methods remain disabled until these values and the related
# provider/Telegram/UPI operational approvals have been supplied.
TICKET_WHITE_LABEL_PROVIDER_NAMESPACE=
TICKET_WHITE_LABEL_WEBHOOK_SECRET=
TICKET_MANUAL_UPI_ENABLED=false
TICKET_TELEGRAM_STARS_BOT_TOKEN=
TICKET_TELEGRAM_STARS_BOT_USERNAME=
# Must be an absolute HTTPS URL. A separately operated bot registers this
# webhook and dispatches invoices; this API only handles inbound updates.
TICKET_TELEGRAM_STARS_WEBHOOK_URL=
TICKET_TELEGRAM_STARS_WEBHOOK_SECRET=
TICKET_TELEGRAM_STARS_INVOICE_PAYLOAD_SECRET=
# Allows only the time-critical answerPreCheckoutQuery call. Leave false until
# the bot webhook is live and monitored.
TICKET_TELEGRAM_STARS_ALLOW_BOT_API_CALLS=false
TICKET_TELEGRAM_STARS_PER_INR=1
TICKET_TELEGRAM_STARS_PRICE_VERSION=telegram-stars-v1
TICKET_PAYMENT_OUTBOX_BATCH_SIZE=100
TICKET_PAYMENT_EXPIRY_POLL_SECONDS=60
TICKET_PAYMENT_OUTBOX_POLL_SECONDS=15
TICKET_PAYMENT_RECONCILIATION_POLL_SECONDS=300
# This worker only freezes committed draws after the sales window ends. It
# never reveals a seed, selects winners, posts prizes, or publishes results.
TICKET_DRAW_CLOSE_POLL_SECONDS=60
TICKET_DRAW_CLOSE_BATCH_SIZE=100
TICKET_ALLOWED_ORIGINS=["http://localhost:8000"]
# /health is liveness; /ready checks PostgreSQL and Redis. Keep both behind
# deployment monitoring and do not interpret either as payment/provider approval.
